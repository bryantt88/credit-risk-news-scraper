# Copy this file to .env and fill in your keys.
# The pipeline loads .env automatically at startup (no python-dotenv needed).

# Required. Free key at https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional. Only needed if you pick an OpenRouter judge model at startup.
# Key + credit at https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
