# Copy this file to .env and fill in your keys.
# The pipeline loads .env automatically at startup (no python-dotenv needed).

# Required. Free key at https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Default path. Powers Phase 2 LLM triage and the OpenRouter judge model.
# Key + credit at https://openrouter.ai/
# (To run without it: set USE_LLM_TRIAGE = False and pick the Claude CLI judge.)
OPENROUTER_API_KEY=your_openrouter_api_key_here
